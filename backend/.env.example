# ES: Copia como .env y ajusta. EN: Copy as .env and adjust.

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://appuser:appsecret@localhost:5432/outdaxius

# --- Environment ------------------------------------------------------------
# dev | demo | test | production.
# scripts/seed_demo.py refuses to run unless this is a non-production value.
APP_ENV=dev

# --- JWT / Authentication ---------------------------------------------------
SECRET_KEY=change_me_before_deploying
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Vendor payment-credential encryption -----------------------------------
# Fernet key protecting company_payment_accounts.credentials_encrypted. The app refuses to
# boot without it. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=

# --- CORS -------------------------------------------------------------------
# Comma-separated origins. Values are used verbatim, so no trailing slashes.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Debugging --------------------------------------------------------------
# Set to 1 to echo every SQL statement and its bound parameters. Off by default: it is very
# noisy and would write user data into the application log.
# SQL_ECHO=1
